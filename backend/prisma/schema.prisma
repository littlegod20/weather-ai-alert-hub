 generator client {
 provider = "prisma-client"
 output   = "../src/generated/prisma"
 }

datasource db {
  provider = "postgresql"
}

enum TriggerType {
  RAIN
  EXTREME_WIND
  FROST
  DROUGHT
}

model Location {
  id        String        @id @default(cuid())
  label     String
  lat       Float
  lon       Float
  timezone  String        @default("UTC")
  units     String        @default("metric")
  triggers  TriggerType[]
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  alerts   AlertEvent[]
  pollLogs PollLog[]

  @@index([active])
}

model AlertEvent {
  id          String      @id @default(cuid())
  locationId  String
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  triggerType TriggerType
  message     String
  snapshot    Json
  triggeredAt DateTime    @default(now())

  @@index([locationId, triggeredAt])
}

model PollLog {
  id             String   @id @default(cuid())
  locationId     String
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  polledAt       DateTime @default(now())
  cacheHit       Boolean
  statusCode     Int
  quotaRemaining Int?

  @@index([locationId, polledAt])
}

model QuotaSnapshot {
  id         String   @id @default(cuid())
  recordedAt DateTime @default(now())
  limitTotal Int
  remaining  Int
  resetAt    DateTime
}