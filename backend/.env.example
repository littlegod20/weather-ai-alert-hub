PORT=4000
NODE_ENV=development

WEATHERAI_API_KEY=wai_your_key_here
WEATHERAI_BASE_URL=https://api.weather-ai.co
WEATHERAI_MONTHLY_LIMIT=1000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weatherai_alert_hub
REDIS_URL=redis://localhost:6379

SCHEDULER_TICK_SECONDS=60
MIN_POLL_INTERVAL_SECONDS=1800
WEATHER_CACHE_TTL_SECONDS=1500
QUOTA_SAFETY_BUFFER=20